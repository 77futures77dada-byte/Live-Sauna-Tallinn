# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the client. Used by
# admin API routes that bypass RLS (see docs/ARCHITECTURE.md section 3).
SUPABASE_SERVICE_ROLE_KEY=

# Weather — Ilmateenistus (decision: docs/ARCHITECTURE.md section 9.3).
# Confirm the current feed URL from ilmateenistus.ee before Phase 1 —
# not filled in here to avoid shipping a guessed endpoint.
ILMATEENISTUS_API_URL=

# Gemini API — used by app/api/assistant/route.ts (Phase 4)
GEMINI_API_KEY=
